# 統一換行：repo 內一律 LF，避免 WSL/Windows (/mnt/d) 交叉造成的 CRLF 雜訊
* text=auto eol=lf

# 明確的文字型別（保險）
*.py    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sql   text eol=lf
*.sh    text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.txt   text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf

# Lock 檔：文字但鎖 LF
*.lock  text eol=lf
uv.lock text eol=lf

# 二進位：絕不做 EOL 轉換
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   text eol=lf
*.pdf   binary
*.gz    binary
*.zip   binary
*.parquet binary
*.duckdb  binary
*.so    binary
*.pkl   binary
*.stackdump binary
