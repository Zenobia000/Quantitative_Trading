# Copy to .env and fill in real values. NEVER commit .env.

# --- FinLab (主資料源, ADR-006) ---
# 取得方式：https://ai.finlab.tw 登入 → 個人資料 → API Token
FINLAB_API_TOKEN=

# --- TEJ (TQuant-Lab 主骨架, ADR-005) ---
# 取得方式：https://tquant.tejwin.com 註冊
# 若無 TEJ key 仍可使用 zipline-tej framework，但 ingest 需用自製 bundle (見 S3)
TEJAPI_KEY=
TEJAPI_BASE=https://api.tej.com.tw

# --- FinMind (fallback 資料源) ---
FINMIND_TOKEN=

# --- Shioaji (永豐金證券, M4-M5 實盤, ADR-008) ---
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=
SHIOAJI_CA_PATH=
SHIOAJI_CA_PASSWORD=
SHIOAJI_PERSON_ID=
SHIOAJI_SIMULATION=true

# --- TimescaleDB ---
POSTGRES_USER=quant
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=quant_trading
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=admin

# --- Prefect ---
PREFECT_API_URL=http://localhost:4200/api

# --- Discord alert (ADR-009, migrated from Telegram) ---
# 取得方式：
#   1. Bot Token: https://discord.com/developers/applications → 你的 App → Bot → Reset Token
#      (Token 僅顯示一次，立刻複製到 .env，勿提交)
#   2. 邀請 Bot 入伺服器: OAuth2 → URL Generator
#      - scopes: bot
#      - permissions: 只勾 Send Messages (2048) + Embed Links (16384) = 18432
#        切勿用 Administrator (8)，警報用途不需要
#   3. Guild/Channel/User ID:
#      Discord → 設定 → 進階 → 開啟「開發者模式」
#      右鍵 伺服器/頻道/使用者 → 複製 ID
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_USER_ID=
# 警報送達目標: channel (送頻道, 預設) | dm (私訊使用者)
DISCORD_ALERT_TARGET=channel

# --- Sprint 0 / M2 specific ---
# Zipline data directory (預設 ~/.zipline，可改本專案內)
ZIPLINE_ROOT=./data/zipline
# InfluxDB (M4+ 系統 metric — docker-compose influxdb 服務 + Grafana datasource)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=local-dev-token
INFLUXDB_ORG=quant
INFLUXDB_BUCKET=metrics
INFLUXDB_USER=quant
INFLUXDB_PASSWORD=change_me_in_production
INFLUXDB_PORT=8086
