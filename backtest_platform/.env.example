# Copy to .env and fill in real values. NEVER commit .env.

# --- FinLab (主資料源, ADR-006) ---
# 取得方式：https://ai.finlab.tw 登入 → 個人資料 → API Token
FINLAB_API_TOKEN=

# --- TEJ (TQuant-Lab 主骨架, ADR-005) ---
# 取得方式：https://tquant.tejwin.com 註冊
# 若無 TEJ key 仍可使用 zipline-tej framework，但 ingest 需用自製 bundle (見 S3)
TEJAPI_KEY=
TEJAPI_BASE=https://api.tej.com.tw

# --- FinMind (fallback 資料源) ---
FINMIND_TOKEN=

# --- Shioaji (永豐金證券, M4-M5 實盤, ADR-008) ---
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=
SHIOAJI_CA_PATH=
SHIOAJI_CA_PASSWORD=
SHIOAJI_PERSON_ID=
SHIOAJI_SIMULATION=true

# --- TimescaleDB ---
POSTGRES_USER=quant
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=quant_trading
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=admin

# --- Prefect ---
PREFECT_API_URL=http://localhost:4200/api

# --- Telegram alert (ADR-009) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Sprint 0 / M2 specific ---
# Zipline data directory (預設 ~/.zipline，可改本專案內)
ZIPLINE_ROOT=./data/zipline
# InfluxDB (M4+ 系統 metric)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=quant
INFLUXDB_BUCKET=metrics
