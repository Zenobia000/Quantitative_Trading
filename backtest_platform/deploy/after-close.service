[Unit]
Description=backtest_platform after-close paper session (forward live OOS)
Documentation=file:%h/Quantitative_Trading/dev_docs/14_deployment_and_operations_guide.md
# Only run once the network is up (FinLab EOD panel + Discord alert both need it).
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Absolute path to the checkout; override for your machine.
WorkingDirectory=%h/Quantitative_Trading/backtest_platform
# Load secrets (FINLAB_API_TOKEN / POSTGRES_* / DISCORD_*) — gitignored, never in VCS.
EnvironmentFile=%h/Quantitative_Trading/backtest_platform/.env
# --date defaults to today Asia/Taipei; the trading-day + after-close guards make
# a weekend / holiday / early fire a clean no-op (exit 0). A failed daily flow
# exits 1 → systemd marks the unit failed and the run alerts Discord.
ExecStart=/usr/bin/env uv run python -m backtest_platform.orchestration.cli \
    after-close --strategy inst_flow --universe 2330,2317,2454,2308,2382
# Give the EOD ingest + chain room; a stuck run is killed, not left hanging.
TimeoutStartSec=1800

[Install]
WantedBy=default.target
