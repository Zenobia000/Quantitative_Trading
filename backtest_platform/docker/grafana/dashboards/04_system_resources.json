{
  "uid": "sys-i-resources",
  "title": "I · 系統資源",
  "tags": ["backtest-platform", "system", "resources"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "CPU 使用率 % (告警 > 80%)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "influxdb-metrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 80 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ {
        "refId": "A",
        "query": "from(bucket: \"metrics\")\n  |> range(start: -6h)\n  |> filter(fn: (r) => r._measurement == \"system\" and r._field == \"cpu_pct\")\n  |> last()"
      } ]
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "RAM 使用率 % (告警 > 85%)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "influxdb-metrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 85 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ {
        "refId": "A",
        "query": "from(bucket: \"metrics\")\n  |> range(start: -6h)\n  |> filter(fn: (r) => r._measurement == \"system\" and r._field == \"mem_pct\")\n  |> last()"
      } ]
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Disk 使用率 % (/, /data，告警 > 80%)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "influxdb-metrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 80 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ {
        "refId": "A",
        "query": "from(bucket: \"metrics\")\n  |> range(start: -6h)\n  |> filter(fn: (r) => r._measurement == \"system\" and r._field == \"disk_pct\")\n  |> group(columns: [\"mount\"])\n  |> last()"
      } ]
    }
  ]
}
