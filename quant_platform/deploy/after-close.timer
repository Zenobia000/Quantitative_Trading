[Unit]
Description=Trigger the quant_platform after-close paper session (Mon-Fri, post TWSE close)
Documentation=file:%h/Quantitative_Trading/dev_docs/14_deployment_and_operations_guide.md

[Timer]
# Weekdays 14:35 Asia/Taipei — a 65-minute buffer past the 13:30 TWSE close. If your
# data source publishes 三大法人 net-buy later, push this (e.g. 17:35) and it stays
# consistent with the CLI's 14:30 --force-able gate.
OnCalendar=Mon..Fri 14:35 Asia/Taipei
# Catch up a run missed while the machine was asleep/off (the idempotency marker
# stops a double-run for the same session).
Persistent=true
# Jitter avoids hammering FinLab at the exact same second every day.
RandomizedDelaySec=120
Unit=after-close.service

[Install]
WantedBy=timers.target
