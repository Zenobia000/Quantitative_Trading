{
  "openapi": "3.1.0",
  "info": {
    "title": "Backtest Platform Research API",
    "version": "0.6.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Liveness probe — returns the API version.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          }
        }
      }
    },
    "/runs": {
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "List Runs",
        "description": "Paginated list of run summaries (newest-first as stored in the ledger).",
        "operationId": "list_runs_runs_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "1-based page index",
              "default": 1,
              "title": "Page"
            },
            "description": "1-based page index"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "description": "page size",
              "default": 50,
              "title": "Limit"
            },
            "description": "page size"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "runs"
        ],
        "summary": "Create Run",
        "description": "Trigger one IS run: build+validate a RunConfig, judge it, append to the ledger.\n\nA bad config (unknown preset, reversed window, ...) surfaces as 422 from the\ndomain validator rather than a 500.",
        "operationId": "create_run_runs_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/runs/compare": {
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "Compare",
        "description": "Cross-run comparison: per-metric delta vs baseline, ranks, sign consistency.",
        "operationId": "compare_runs_compare_get",
        "parameters": [
          {
            "name": "baseline",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "run_id to diff against",
              "title": "Baseline"
            },
            "description": "run_id to diff against"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{run_id}": {
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "Get Run",
        "description": "Full ledger record for one run; 404 if absent.",
        "operationId": "get_run_runs__run_id__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/gate/spec": {
      "get": {
        "tags": [
          "gate"
        ],
        "summary": "Gate Spec",
        "description": "Return the default gate's criteria (key / op / threshold / kind / label).",
        "operationId": "gate_spec_gate_spec_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          }
        }
      }
    },
    "/gate/evaluate": {
      "post": {
        "tags": [
          "gate"
        ],
        "summary": "Gate Evaluate",
        "description": "Judge a metrics dict against the default gate.",
        "operationId": "gate_evaluate_gate_evaluate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GateEvaluateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/metrics/summary": {
      "post": {
        "tags": [
          "metrics"
        ],
        "summary": "Metrics Summary",
        "description": "A/B/C metrics (total return, CAGR, drawdown, Sharpe, Sortino, Calmar).",
        "operationId": "metrics_summary_metrics_summary_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MetricsSummaryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/metrics/trades": {
      "post": {
        "tags": [
          "metrics"
        ],
        "summary": "Metrics Trades",
        "description": "E metrics (win rate, profit factor, avg hold, Kelly fraction).\n\nThe trade records must carry the ``pnl`` (and, for avg hold, ``hold_days``)\nkeys; a missing key is a 400 (client sent the wrong shape) rather than a 500.",
        "operationId": "metrics_trades_metrics_trades_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TradeMetricsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/presets": {
      "get": {
        "tags": [
          "presets"
        ],
        "summary": "List Presets",
        "description": "List preset names plus each preset's full parameter dict.",
        "operationId": "list_presets_presets_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          }
        }
      }
    },
    "/presets/{name}": {
      "get": {
        "tags": [
          "presets"
        ],
        "summary": "Get One Preset",
        "description": "Return one preset's parameters; 404 if the name is unknown.",
        "operationId": "get_one_preset_presets__name__get",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/research/strategies": {
      "get": {
        "tags": [
          "research",
          "research"
        ],
        "summary": "List Strategies",
        "description": "Strategy roster projected over the runs ledger (grouped by preset).",
        "operationId": "list_strategies_research_strategies_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Envelope": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "data": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Data"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "meta": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Meta"
          }
        },
        "type": "object",
        "required": [
          "success"
        ],
        "title": "Envelope",
        "description": "The single response shape shared by every endpoint."
      },
      "GateEvaluateRequest": {
        "properties": {
          "metrics": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Metrics",
            "description": "run metrics, e.g. {cagr, sharpe, struct1_pct, ...}"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "metrics"
        ],
        "title": "GateEvaluateRequest",
        "description": "Judge an arbitrary metrics dict against the審判庭 (ADR-016 + ADR-019)."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MetricsSummaryRequest": {
        "properties": {
          "daily_returns": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "minItems": 1,
            "title": "Daily Returns",
            "description": "per-period returns"
          },
          "risk_free": {
            "type": "number",
            "title": "Risk Free",
            "description": "annual risk-free rate",
            "default": 0.0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "daily_returns"
        ],
        "title": "MetricsSummaryRequest",
        "description": "Compute the A/B/C performance metrics over a daily-returns series."
      },
      "RunCreateRequest": {
        "properties": {
          "hypothesis": {
            "type": "string",
            "minLength": 1,
            "title": "Hypothesis",
            "description": "預先註冊：這個 run 在驗什麼"
          },
          "preset": {
            "type": "string",
            "title": "Preset",
            "description": "StrategyConfig preset name (v2 / v3 / ...)"
          },
          "stocks": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Stocks",
            "description": "Stock ids to run"
          },
          "is_start": {
            "type": "string",
            "format": "date",
            "title": "Is Start"
          },
          "is_end": {
            "type": "string",
            "format": "date",
            "title": "Is End"
          },
          "engine": {
            "type": "string",
            "title": "Engine",
            "description": "sim | zipline",
            "default": "sim"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "hypothesis",
          "preset",
          "stocks",
          "is_start",
          "is_end"
        ],
        "title": "RunCreateRequest",
        "description": "Trigger one IS run — the HTTP form of a ``RunConfig`` (validated downstream)."
      },
      "TradeMetricsRequest": {
        "properties": {
          "trades": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "minItems": 1,
            "title": "Trades",
            "description": "trade records carrying pnl / hold_days keys"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "trades"
        ],
        "title": "TradeMetricsRequest",
        "description": "Compute the E (trade-quality) metrics over a list of trade records."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}